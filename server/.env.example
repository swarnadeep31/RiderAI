# Copy this file to .env and fill it in.

# Your MongoDB connection string, e.g. from MongoDB Atlas (free tier):
#   mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/trailcast
# Leave it empty to use a temporary in-memory database while developing.
# Everything you save is lost when the server stops.
MONGODB_URI=

# A long random string used to sign login sessions. Anyone who knows it can
# log in as any user, so keep it secret. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional while developing; required once the site is online.
JWT_SECRET=

# Optional: lets routes drawn between key points follow real roads and footpaths.
# Get a free key at https://openrouteservice.org (sign up, then "API Keys").
# Without it, those routes are drawn as straight lines.
ORS_API_KEY=

# Optional: the AI route builder (Gemini watches a public YouTube video and
# lists the places it passes). Free key at https://aistudio.google.com ("Get API key").
GEMINI_API_KEY=
# Which Gemini model to use. List the ones your key can use with:
#   npm run try-ai -w server -- --list-models
GEMINI_MODEL=gemini-3.5-flash-lite
# How much the model "thinks" first (charged like its answer): MINIMAL, LOW, MEDIUM or HIGH.
GEMINI_THINKING_LEVEL=MINIMAL
# true: look at the video in more detail by default (reads sign boards better, about 3x the cost).
AI_HIGH_DETAIL=false
# Limits that stop a runaway bill.
AI_JOBS_PER_USER_PER_DAY=3
AI_MONTHLY_BUDGET_USD=5
AI_MAX_VIDEO_MINUTES=180
# Long videos are sent in pieces of this many minutes.
AI_CLIP_MINUTES=60
# Places the AI is less sure of than this (0 to 1) start unticked in the review.
AI_MIN_CONFIDENCE=0.5
# For showing costs in rupees in the try-ai script.
AI_INR_PER_USD=88
# If Google changes its prices (US dollars per million tokens):
# AI_PRICE_INPUT_PER_M=0.30
# AI_PRICE_OUTPUT_PER_M=2.50

PORT=4000
